# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# WebSocket Configuration
WS_PORT=3002

# Image Processing
MAX_IMAGE_SIZE=5242880
IMAGE_QUALITY=80

# Twilio Emergency Call Configuration (Get credentials at https://www.twilio.com/try-twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_32_character_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
AEYE_EMERGENCY_CONTACT=+1234567890
AEYE_LOCATION=Your location here
